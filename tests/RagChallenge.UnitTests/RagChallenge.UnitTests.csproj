<Project Sdk="Microsoft.NET.Sdk">

  <!-- Verifies framework-neutral scaffold invariants without introducing functional behaviour. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RagChallenge.UnitTests</AssemblyName>
    <RootNamespace>RagChallenge.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RagChallenge.Application\RagChallenge.Application.csproj" />
    <ProjectReference Include="..\..\src\RagChallenge.Domain\RagChallenge.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
