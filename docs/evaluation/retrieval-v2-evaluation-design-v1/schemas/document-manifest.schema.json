{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-manifest.schema.json",
  "title": "Future retrieval evaluation document manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "artifactType", "evaluationDesignContractRevision", "status", "authorityId", "createdDate", "datasetRevision", "documents"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "DocumentManifest" },
    "evaluationDesignContractRevision": { "const": "retrieval-v2-evaluation-design-v1" },
    "status": { "type": "string", "minLength": 1 },
    "authorityId": { "type": "string", "minLength": 1 },
    "createdDate": { "type": "string", "format": "date" },
    "datasetRevision": { "$ref": "#/$defs/id" },
    "documents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/document" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["databaseProductId", "databaseProductRevision", "documentId", "documentVersion", "documentFormat", "contentSha256", "contentLanguage", "sourceDeclaredLanguage", "sourceAdapterId", "sourceTrustClass", "officialSourceRegistrationIdOrLocalSentinel", "rightsDisposition", "eligibility", "parserDescriptor", "chunkerDescriptor", "embeddingDescriptor", "sourceBindingDigest", "activationBindingDigest"],
      "properties": {
        "databaseProductId": { "$ref": "#/$defs/id" }, "databaseProductRevision": { "$ref": "#/$defs/id" }, "documentId": { "$ref": "#/$defs/id" }, "documentVersion": { "$ref": "#/$defs/id" }, "documentFormat": { "enum": ["PDF", "CSV"] }, "contentSha256": { "$ref": "#/$defs/sha256" }, "contentLanguage": { "$ref": "#/$defs/id" }, "sourceDeclaredLanguage": { "$ref": "#/$defs/id" }, "sourceAdapterId": { "$ref": "#/$defs/id" }, "sourceTrustClass": { "enum": ["LocalAuthorised", "OfficialExternal"] }, "officialSourceRegistrationIdOrLocalSentinel": { "$ref": "#/$defs/id" }, "officialSnapshotId": { "$ref": "#/$defs/id" }, "rightsDisposition": { "$ref": "#/$defs/id" }, "eligibility": { "enum": ["Eligible", "Ineligible"] }, "parserDescriptor": { "$ref": "#/$defs/id" }, "chunkerDescriptor": { "$ref": "#/$defs/id" }, "embeddingDescriptor": { "$ref": "#/$defs/id" }, "sourceBindingDigest": { "$ref": "#/$defs/sha256" }, "activationBindingDigest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "sourceTrustClass": { "const": "OfficialExternal" } }, "required": ["sourceTrustClass"] },
          "then": { "required": ["officialSnapshotId"] }
        }
      ]
    }
  }
}
