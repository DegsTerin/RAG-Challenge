{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-challenge.local/schemas/ai-orchestrator/agent-result-v1.json",
  "title": "RAG-Challenge AI orchestrator agent result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "changedFiles",
    "commands",
    "tests",
    "evidence",
    "risks",
    "blockers",
    "requestedAuthority",
    "stopCondition"
  ],
  "properties": {
    "status": { "enum": ["PASS", "FAIL", "BLOCKED", "HUMAN_REVIEW_REQUIRED"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "changedFiles": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
    "commands": { "$ref": "#/$defs/commands" },
    "tests": { "$ref": "#/$defs/commands" },
    "evidence": { "$ref": "#/$defs/textList" },
    "risks": { "$ref": "#/$defs/textList" },
    "blockers": { "$ref": "#/$defs/textList" },
    "requestedAuthority": { "$ref": "#/$defs/textList" },
    "stopCondition": {
      "type": ["string", "null"],
      "enum": [
        null,
        "AMBIGUOUS_AUTHORITY",
        "CONFLICTING_REQUIREMENTS",
        "ARCHITECTURE_CHANGE_REQUIRED",
        "PUBLIC_CONTRACT_CHANGE_REQUIRED",
        "SCHEMA_CHANGE_REQUIRED",
        "MIGRATION_REQUIRED",
        "DESTRUCTIVE_OPERATION",
        "SECRET_REQUIRED",
        "PROVIDER_CHANGE_REQUIRED",
        "HUMAN_DECISION_REQUIRED",
        "HUMAN_GATE_REQUIRED",
        "UNEXPECTED_DIRTY_TREE",
        "SHARED_RESOURCE_COLLISION",
        "OUT_OF_SCOPE_CHANGE_REQUIRED",
        "TEST_BASELINE_BROKEN"
      ]
    }
  },
  "$defs": {
    "textList": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 2048 } },
    "commands": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commandId", "exitCode", "durationMs", "result", "relevantOutput"],
        "properties": {
          "commandId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
          "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "relevantOutput": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 512 } }
        }
      }
    }
  }
}
