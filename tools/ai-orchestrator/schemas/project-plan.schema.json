{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-challenge.local/schemas/ai-orchestrator/project-plan-v1.json",
  "title": "RAG-Challenge AI orchestrator project plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "baseline", "maxConcurrency", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "const": "RAG-Challenge" },
    "baseline": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 3 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "textList": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId", "taskKind", "title", "objective", "authority", "executionSurface", "owner", "status", "priority", "dependencies", "blockedBy",
        "allowedPaths", "forbiddenPaths", "ownership", "sharedResources", "requiredContracts", "acceptanceCriteria",
        "requiredTests", "stopConditions", "deliverables", "worktree", "branch", "parallelism",
        "requiresIndependentReview", "requiresSecurityReview", "humanGate", "candidateTaskId", "candidate", "maxAttempts", "createdAt", "startedAt",
        "finishedAt", "result", "evidence"
      ],
      "properties": {
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "taskKind": { "enum": ["DISCOVERY", "IMPLEMENTATION", "INDEPENDENT_REVIEW", "SECURITY_REVIEW", "INTEGRATION", "QUALITY_GATE", "HUMAN_GATE"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["references", "grants", "negativeScope"],
          "properties": {
            "references": { "$ref": "#/$defs/textList" },
            "grants": { "$ref": "#/$defs/textList" },
            "negativeScope": { "$ref": "#/$defs/textList" }
          }
        },
        "executionSurface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cwd", "writableRoots", "sandbox", "approvalPolicy", "networkAccess", "environmentPolicy", "tools", "mcpServers", "skills"],
          "properties": {
            "cwd": { "type": "string", "minLength": 1, "maxLength": 240 },
            "writableRoots": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
            "sandbox": { "enum": ["read-only", "workspace-write"] },
            "approvalPolicy": { "const": "never" },
            "networkAccess": { "const": false },
            "environmentPolicy": { "const": "minimal" },
            "tools": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "mcpServers": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
            "skills": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 128 } }
          }
        },
        "owner": { "enum": ["governance_guard", "code_mapper", "architect", "implementation_worker", "independent_reviewer", "security_reviewer"] },
        "status": { "enum": ["DISCOVERED", "READY", "BLOCKED", "ASSIGNED", "RUNNING", "IMPLEMENTED", "TESTING", "REVIEW", "INTEGRATION_READY", "INTEGRATING", "VALIDATING", "PASS", "FAIL", "HUMAN_REVIEW_REQUIRED", "CANCELLED"] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "dependencies": { "$ref": "#/$defs/textList" },
        "blockedBy": { "$ref": "#/$defs/textList" },
        "allowedPaths": { "$ref": "#/$defs/textList" },
        "forbiddenPaths": { "$ref": "#/$defs/textList" },
        "ownership": { "enum": ["READ_ONLY_FOR_WORKERS", "SINGLE_OWNER", "LANE_OWNED", "SHARED_BUT_FROZEN", "GENERATED", "HUMAN_CONTROLLED", "COORDINATOR_ONLY"] },
        "sharedResources": { "$ref": "#/$defs/textList" },
        "requiredContracts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contractId", "state", "owner"],
            "properties": {
              "contractId": { "type": "string", "minLength": 1, "maxLength": 128 },
              "state": { "enum": ["FROZEN", "MUTABLE_WITH_OWNER", "HUMAN_CONTROLLED"] },
              "owner": { "type": "string", "minLength": 1, "maxLength": 128 }
            }
          }
        },
        "acceptanceCriteria": { "$ref": "#/$defs/textList" },
        "requiredTests": { "$ref": "#/$defs/textList" },
        "stopConditions": { "$ref": "#/$defs/textList" },
        "deliverables": { "$ref": "#/$defs/textList" },
        "worktree": { "type": ["string", "null"], "maxLength": 240 },
        "branch": { "type": ["string", "null"], "maxLength": 240 },
        "parallelism": { "enum": ["SAFE_PARALLEL", "CONTRACT_FROZEN_PARALLEL", "SINGLE_OWNER", "SEQUENTIAL_ONLY"] },
        "requiresIndependentReview": { "type": "boolean" },
        "requiresSecurityReview": { "type": "boolean" },
        "humanGate": { "type": "boolean" },
        "candidateTaskId": { "type": ["string", "null"], "maxLength": 64 },
        "candidate": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["commitId", "treeId", "changedFiles"],
              "properties": {
                "commitId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "treeId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "changedFiles": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
              }
            }
          ]
        },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": ["string", "null"], "format": "date-time" },
        "finishedAt": { "type": ["string", "null"], "format": "date-time" },
        "result": { "type": ["object", "null"] },
        "evidence": { "$ref": "#/$defs/textList" }
      }
    }
  }
}
