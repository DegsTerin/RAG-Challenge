{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-challenge.invalid/schemas/language-policy-v1.json",
  "title": "RAG-Challenge language enforcement policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "payload", "digest"],
  "properties": {
    "$schema": { "const": "./language-policy.schema.json" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "policyId",
        "technicalLanguage",
        "ownerLanguage",
        "bannedAmericanSpellings",
        "portugueseTechnicalMarkers",
        "scannedExtensions",
        "excludedPaths",
        "excludedRegions",
        "appendOnlyPrefixes"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "policyId": { "const": "rag-challenge-language-policy-v1" },
        "technicalLanguage": { "const": "en-GB" },
        "ownerLanguage": { "const": "pt-BR" },
        "bannedAmericanSpellings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["american", "british"],
            "properties": {
              "american": { "type": "string", "pattern": "^[a-z]+$" },
              "british": { "type": "string", "pattern": "^[a-z]+$" }
            }
          }
        },
        "portugueseTechnicalMarkers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "scannedExtensions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[.][a-z0-9]+$" }
        },
        "excludedPaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "classification", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "classification": {
                "enum": [
                  "FROZEN_PUBLIC_CONTRACT",
                  "GENERATED_MIGRATION",
                  "FUNCTIONAL_LOCALISATION",
                  "OWNER_FACING_PT_BR",
                  "SOURCE_OR_CITATION_DATA",
                  "EXTERNAL_CANONICAL_FORMAT"
                  ,"ACCEPTED_ARCHITECTURE_HISTORY"
                  ,"HISTORICAL_EVIDENCE"
                  ,"FROZEN_EVALUATION_DATA"
                ]
              },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "excludedRegions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "classification", "startMarker", "endMarker", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "classification": { "const": "PRESERVED_HISTORICAL_REGION" },
              "startMarker": { "type": "string", "minLength": 1 },
              "endMarker": { "type": ["string", "null"] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "appendOnlyPrefixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "prefixBytes", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "prefixBytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
