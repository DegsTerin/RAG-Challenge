<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hosts the selected persistence, parsing, provider and official-source adapters outside the inner layers. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-arm64</RuntimeIdentifiers>
    <AssemblyName>RagChallenge.Infrastructure</AssemblyName>
    <RootNamespace>RagChallenge.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RagChallenge.Application\RagChallenge.Application.csproj" />
    <ProjectReference Include="..\RagChallenge.Domain\RagChallenge.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

</Project>
